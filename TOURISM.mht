------MultipartBoundary--IsREen6xoF3r8CGy0MdcZ5dmsf8pFxn9E2pvsqSOQN----
Content-Type: text/css
Content-Transfer-Encoding: binary
Content-Location: https://www.lakebunyonyiuganda.com/wp-content/themes/primeparks/style.css?ver=7.0.7

@charset "utf-8";

:root { --darkest-color: #293b5f; --darker-color: #8f8971; --darker-green-color: #47597e; --light-brown: #f0ebcc; --lighter-brown: #cbc7ad; --lighter-brown-alt: #f0ebcc; --light-orange-color: #ffc947; --dark-orange-color: #ffc947; --heading-font: 'Baloo 2', cursive; --main-font: 'Montserrat', sans-serif; }

body { font-family: var(--main-font); font-style: normal; font-weight: 400; font-size: 16px; line-height: 32px; color: rgb(49, 49, 49); }

h1, h2, h3, h4, h5, h6 { font-family: var(--heading-font); margin-bottom: 20px; }

p { margin-bottom: 30px; }

img { height: auto; max-width: 100%; }

[type="color"], [type="date"], [type="datetime-local"], [type="datetime"], [type="email"], [type="month"], [type="number"], [type="password"], [type="search"], [type="tel"], [type="text"], [type="time"], [type="url"], [type="week"], select, textarea { display: block; box-sizing: border-box; background-color: rgb(254, 254, 254); box-shadow: rgba(10, 10, 10, 0.1) 0px 3px 5px inset; font-family: inherit; font-size: 1rem; font-weight: 400; transition: box-shadow 0.5s, border-color 0.25s ease-in-out; appearance: none; float: none !important; width: 100% !important; height: 2.8375rem !important; margin: 0px 0px 1rem !important; padding: 0.5rem !important; border: 1px solid rgb(204, 204, 204) !important; border-radius: 0px !important; }

label { width: 100%; }

textarea { height: 150px !important; }

.navbar { }

.navbar .nav-link { font-family: var(--heading-font); font-weight: 700; font-size: 17px; line-height: 21px; letter-spacing: 0.05em; color: rgb(255, 255, 255); padding-left: 20px !important; padding-right: 20px !important; }

.navbar .nav-link:hover { color: var(--lighter-brown); }

.navbar .nav-link.current, .navbar .nav-link.active { color: var(--lighter-brown); }

.navbar-nav li:hover > ul.dropdown-menu { display: block; }

.navbar-nav li ul.dropdown-menu { padding: 10px; background-color: var(--darkest-color) !important; border-radius: 0px !important; }

.navbar-nav li ul.dropdown-menu li a { margin-bottom: 5px; font-weight: 700; color: rgb(255, 255, 255); font-size: 14px !important; }

.navbar-nav li ul.dropdown-menu li a.active { background-color: var(--dark-orange-color) !important; }

.navbar-nav li ul.dropdown-menu li a:hover { border-radius: 0px; color: var(--darkest-color); background-color: var(--light-orange-color) !important; }

.dropdown-toggle::after { display: inline-block; margin-left: 0.255em; vertical-align: 0.255em; content: ""; border-width: 0.3em 0.3em 0px; border-style: solid solid none; border-color: currentcolor transparent; }

.dropdown-submenu { position: relative; }

.dropdown-submenu > .dropdown-menu { top: 0px; left: 100%; margin-top: -6px; }

.site-branding { margin-top: -36px; border-bottom-left-radius: 30px; border-bottom-right-radius: 30px; }

.site-branding .logo { width: 100px; height: 97px; }

.dropdown-menu > li > a:hover::after { text-decoration: underline; transform: rotate(-90deg); }

.banner-home { background: url("images/bigslide.jpg") center center / cover; height: 700px; }

.page-update { height: 600px; background-size: cover !important; background-position: center center !important; }

.category-update { height: 500px; background-size: cover !important; background-position: center center !important; }

.banner-home .home-banner-text h1, .banner-home .home-banner-text h4 { font-family: var(--main-font); }

.page-update h1 { font-family: var(--heading-font) !important; }

.banner-home .home-banner-text h1 { font-weight: 400; font-size: 30px; line-height: 50px; }

.banner-home .home-banner-text h1 span { font-weight: 700; font-size: 65px; line-height: 138.5%; }

.banner-home .home-banner-text h4 { font-weight: 400; font-size: 25px; }

.intro-div { margin-top: -100px; }

.category-no-margin-top { margin-top: 0px; }

.intro-section h2 { font-weight: 700; font-size: 36px; line-height: 50px; }

.safari-wrap { height: 389px; border-radius: 20px; overflow: hidden; }

.safari-wrap .badge { font-size: 20px; color: var(--darkest-color); }

.safari-wrap h4 { font-weight: 700; font-size: 28px; line-height: 39px; }

.safari-wrap .safari-text span { font-family: var(--heading-font); font-size: 20px; line-height: 24px; }

a.safari-wrap-link:hover .safari-wrap .safari-overlay { opacity: 0.7; }

a.safari-wrap-link:hover .safari-wrap .safari-text h4 { text-decoration: underline; }

a.safari-wrap-link:hover .safari-wrap .safari-text span { color: var(--light-orange-color); text-decoration: none !important; }

a.safari-wrap-link:hover .safari-wrap .badge { background: var(--light-orange-color) !important; }

.three-days-lake-bunyonyi { background: url("images/three-days-lake-bunyonyi.jpg") center center / cover; }

.four-days-gorillas-bunyonyi { background: url("images/four-days-gorillas-bunyonyi.jpg") center center / cover; }

.four-days-lake-bunyonyi { background: url("images/four-days-lake-bunyonyi.jpg") center center / cover; }

.five-days-gorillas-bunyonyi { background: url("images/five-days-gorillas-bunyonyi.jpg") center center / cover; }

.seven-days-safari { background: url("images/seven-days-safari.jpg") center center / cover; }

.ten-days-safari { background: url("images/ten-days-safari.jpg") center center / cover; }

.activity-update { background-size: cover !important; background-position: center center !important; }

.activity-update h4 { font-size: 22px !important; line-height: 33px !important; }

.activity-update .activity-excerpt, .activity-update .safari-text span { font-size: 15px !important; }

.news-wrap-update h4 { font-size: 30px !important; line-height: 40px !important; }

.news-wrap-update .safari-text span { font-family: var(--heading-font); font-size: 21px !important; }

.itinerary-wrap-update h4 { font-size: 25px !important; line-height: 35px !important; }

.itinerary-wrap-update .safari-text span { font-family: var(--heading-font); font-size: 17px !important; }

.park-single-item:hover .park-item { opacity: 0.9; }

.park-single-item:hover h4 { background-color: var(--light-orange-color) !important; color: var(--darkest-color) !important; }

.destination-item:hover { color: var(--darkest-color) !important; }

.park-item { height: 277px; border-radius: 10px; overflow: hidden; background-size: cover !important; background-position: center center !important; }

.park-safaris { background: url("images/safaris.jpg"); }

.park-operators { background: url("images/tour-operators.jpg"); }

.park-attractions { background: url("images/attractions.jpg"); }

.park-information { background: url("images/information.jpg"); }

.park-activities { background: url("images/activities.jpg"); }

.park-accommodation { background: url("images/accommodation.jpg"); }

