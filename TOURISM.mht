.index-6 { z-index: 6; }

.index-5 { z-index: 5; }

.index-4 { z-index: 4; }

.index-3 { z-index: 3; }

.text-shadow-main { text-shadow: rgba(0, 0, 0, 0.75) 0px 4px 4px; }

.div-shadow-main { box-shadow: rgba(0, 0, 0, 0.25) 0px 4px 4px; }

.div-shadow-main-dark { box-shadow: rgba(0, 0, 0, 0.75) 0px 4px 4px; }

.btn-warning { background: var(--light-orange-color); border: 2px solid var(--lighter-brown); font-weight: 700; font-size: 25px; color: var(--darkest-color); text-shadow: none; }

.btn-danger { background: var(--dark-orange-color); border: 2px solid var(--lighter-brown); font-weight: 700; font-size: 25px; color: var(--darkest-color); text-shadow: none; }

.btn-outline-light { border: 2px solid rgb(255, 255, 255); font-weight: 700; font-size: 25px; color: rgb(255, 255, 255); text-shadow: none; }

.bg-danger { background-color: var(--dark-orange-color) !important; }

.bg-darker-color { background-color: var(--darker-color) !important; }

.main-top-overlay { background: linear-gradient(
		180deg,
		var(--lighter-brown) 0%,
		rgba(255, 239, 207, 0) 100%
	); height: 317px; }

.main-top-overlay-alt { background: linear-gradient(
		180deg,
		rgba(255, 239, 207, 0) 0%,
		var(--light-brown) 100%
	); height: 317px; }

.main-overlay { background: linear-gradient(36.7deg, rgba(0, 0, 0, 0.6) 63.44%, rgba(0, 0, 0, 0) 100%); inset: 0px; }

.safari-overlay { background: linear-gradient(360deg, rgb(0, 0, 0) 0%, rgba(0, 0, 0, 0) 100%); height: 365px; }

.radius-20 { border-radius: 20px; }

.ta-widget { height: 390px; }

.border-warning-alt { border-color: var(--light-brown) !important; }

.social-icons-lists.icons-background-none .socicon { color: var(--lighter-brown) !important; }

.top-100-minus { margin-top: -200px !important; }

.top-140-minus { margin-top: -148px !important; }

.top-80 { top: 80px; }

.text-light-brown { color: var(--lighter-brown); }

.text-darkest { color: var(--darkest-color); }

.mail-link:hover { color: var(--lighter-brown) !important; text-decoration: underline !important; }

.footercall { display: none; }

.btna { border: 0px; border-radius: 5px; font-weight: 400; font-size: 1rem; height: 2.55rem; line-height: 2.3625rem; width: 100%; color: rgb(255, 255, 255); padding-bottom: 0.3125rem; cursor: pointer; text-shadow: 1px 1px 1px var(--darkest-color); appearance: none; vertical-align: top; white-space: nowrap; transition: opacity 0.2s ease-in-out, background 0.2s ease-in-out, border-color 0.2s ease-in-out; background: var(--dark-orange-color); text-align: center; padding-top: 5px !important; }

.btna:hover, .footercall a:hover { background: var(--light-orange-color); color: var(--darkest-color) !important; text-decoration: none !important; text-shadow: none !important; }

#btn-back-to-top { position: fixed; bottom: 30px; right: 10px; display: none; }

@media (max-width: 1399.98px) {
}

@media (max-width: 1199.98px) {
  .site-branding .logo { width: 63px; height: 60px; }
  .navbar-collapse { background-color: var(--darkest-color); margin-top: 40px; border-radius: 10px; }
  .navbar { background: var(--darker-green-color)
			url(images/perforated-white-leather.png); }
  .banner-home { height: 550px; }
  .intro-div { margin-top: 0px; }
  .btn-warning, .btn-outline-light, .btn-danger { font-size: 17px; }
  .banner-home .home-banner-text h1 { font-size: 35px; }
  .banner-home .home-banner-text h1 span { font-size: 50px; }
  .cta-section { height: auto !important; padding-bottom: 50px; }
  .category-update, .page-update { height: 300px; }
  #CDSWIDSSP { width: 100% !important; }
}

@media only screen and (max-width: 991px) {
  .banner-home .home-banner-text h1 { font-size: 30px; }
  .banner-home .home-banner-text h1 span { font-size: 50px; }
  .banner-home .home-banner-text h4 { font-size: 20px; }
  .footercall { display: block; position: fixed; z-index: 9999999; bottom: 0px; width: 100%; background: rgb(255, 255, 255); box-shadow: rgb(208, 208, 208) 0px -1px 10px; padding: 0.6375rem; }
  #btn-back-to-top { bottom: 80px; }
  .bg-lightest-brown { background: var(--lighter-brown-alt); }
  .top-100-minus, .top-140-minus { margin-top: 0px !important; }
  .top-80 { top: 40px !important; }
}

@media (max-width: 767.98px) {
  .banner-home .home-banner-text h1, .cta-text h2 { font-size: 25px; }
  .banner-home .home-banner-text h1 span { font-size: 45px; }
  .banner-home .home-banner-text h4 { font-size: 20px; }
  .intro-section h2, .safari-wrap h4 { font-size: 25px; line-height: 35px; }
  .cta-text p { font-size: 17px; line-height: 24px; }
}

@media (max-width: 575.98px) {
  .intro-div { border-radius: 0px !important; }
}

